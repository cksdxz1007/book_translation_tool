
# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-secret-key-here

# Application Configuration
APP_PORT=5001
APP_HOST=127.0.0.1
MAX_FILE_SIZE=52428800

# Translation Service Configuration
DEFAULT_SERVICE=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# Ollama Configuration (if using)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama2

# BabelDOC Configuration
BABELDOC_API_URL=https://api.deepseek.com
BABELDOC_API_KEY=your-babeldoc-api-key

# Database Configuration
DATABASE_PATH=data/config.db
ENCRYPTION_KEY_PATH=data/keys/master.key

# Admin Configuration
ADMIN_ACCESS_KEY=your-admin-access-key

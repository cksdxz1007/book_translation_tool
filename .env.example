# 翻译服务API密钥
# 请从您的翻译服务提供商获取API密钥
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 可选：其他服务密钥
# SILICONFLOW_API_KEY=your_siliconflow_key_here
# OPENROUTER_API_KEY=your_openrouter_key_here

# Flask配置
FLASK_ENV=production

# 管理员访问密钥 (使用 openssl rand -base64 32 生成)
ADMIN_ACCESS_KEY=your_admin_access_key_here

# 说明：
# 1. 将此文件复制为 .env
# 2. 填写您的实际API密钥
# 3. 生成管理员密钥：openssl rand -base64 32
# 4. 不要将真实的 .env 文件提交到版本控制